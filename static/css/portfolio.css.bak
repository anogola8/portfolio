:root{--bg:#f6f2ea;--panel:#fffdf8;--ink:#14213a;--mut:#56627a;--line:#d9d2c3;--acc:#007c91;--acc-ink:#fff;--warn:#a15c00;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b1324;--panel:#121c33;--ink:#e9eef8;--mut:#9aa8c2;--line:#25324f;--acc:#3fe0f0;--acc-ink:#04202a;--warn:#f0b04a;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0b1324;--panel:#121c33;--ink:#e9eef8;--mut:#9aa8c2;--line:#25324f;--acc:#3fe0f0;--acc-ink:#04202a;--warn:#f0b04a;color-scheme:dark}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 64px);scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
h1,h2,h3{font-family:Georgia,"Times New Roman",serif;line-height:1.15;margin:0 0 .5em}
h1{font-size:clamp(2.2rem,6vw,4rem);letter-spacing:-.02em}h2{font-size:clamp(1.6rem,3.5vw,2.4rem)}h3{font-size:1.2rem}
a{color:var(--acc)}code,.mono{font-family:ui-monospace,Menlo,Consolas,monospace}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}
section{padding:64px 0;border-top:1px solid var(--line)}
.eyebrow{font:600 .8rem ui-monospace,Menlo,monospace;letter-spacing:.12em;text-transform:uppercase;color:var(--acc);margin-bottom:10px}
header.nav{position:sticky;top:0;z-index:20;background:var(--bg);border-bottom:1px solid var(--line);padding-top:env(safe-area-inset-top,0px)}
.nav .wrap{display:flex;align-items:center;gap:16px;min-height:56px;flex-wrap:wrap}
.brand{font:700 1rem ui-monospace,Menlo,monospace;color:var(--ink);text-decoration:none;margin-right:auto}
.brand b{color:var(--acc)}
nav ul{display:flex;gap:4px;list-style:none;margin:0;padding:0;flex-wrap:wrap}
nav a{display:block;padding:8px 10px;border-radius:6px;color:var(--mut);text-decoration:none;font-size:.92rem}
nav a:hover,nav a.on{color:var(--ink);background:var(--panel)}nav a.on{box-shadow:inset 0 -2px var(--acc)}
.btn{display:inline-block;border:1px solid var(--line);background:var(--panel);color:var(--ink);padding:10px 16px;border-radius:8px;font:600 .95rem inherit;cursor:pointer;text-decoration:none}
.btn.p{background:var(--acc);color:var(--acc-ink);border-color:var(--acc)}
.btn:hover{transform:translateY(-1px)}
:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
#menuBtn{display:none}
@media(max-width:760px){#menuBtn{display:inline-block}nav{width:100%;display:none}nav.open{display:block}nav ul{flex-direction:column}}
.hero{padding:72px 0 56px}
.hero p.lead{font-size:1.2rem;color:var(--mut);max-width:640px}
.cta{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0}
.grid{display:grid;gap:16px}.g2{grid-template-columns:repeat(auto-fit,minmax(280px,1fr))}.g3{grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:18px;position:relative}
.card h3{margin-bottom:.3em}
.snap dt{font:600 .75rem ui-monospace,Menlo,monospace;color:var(--mut);text-transform:uppercase;letter-spacing:.08em}
.snap dd{margin:2px 0 12px}
.tag{display:inline-block;font:.78rem ui-monospace,Menlo,monospace;border:1px solid var(--line);border-radius:999px;padding:2px 10px;margin:0 4px 4px 0;color:var(--mut)}
.st{font:700 .72rem ui-monospace,Menlo,monospace;text-transform:uppercase;letter-spacing:.06em;padding:3px 8px;border-radius:4px;background:var(--acc);color:var(--acc-ink)}
.st.concept{background:transparent;border:1px dashed var(--warn);color:var(--warn)}
.tools{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px}
input,select,textarea{font:inherit;color:var(--ink);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px;width:100%}
.tools input{max-width:280px}.tools select{max-width:200px}
label{display:block;font-weight:600;margin:12px 0 4px}
.err{color:var(--warn);font-size:.88rem;min-height:1.2em;margin:2px 0 0}
details{margin-top:10px;border-top:1px solid var(--line);padding-top:8px}summary{cursor:pointer;font-weight:600}
details dt{font-weight:700;margin-top:8px}details dd{margin:0;color:var(--mut)}
.skill{cursor:pointer;text-align:left;font:inherit;color:inherit;width:100%}
.skill[aria-pressed="true"]{border-color:var(--acc);box-shadow:0 0 0 1px var(--acc)}
.lvl{font:.75rem ui-monospace,Menlo,monospace;color:var(--acc)}
.chain{display:flex;gap:10px;overflow-x:auto;padding-bottom:8px}
.blk{min-width:210px;flex:1}.blk.bad{border-color:var(--warn)}
.hash{font:.72rem ui-monospace,Menlo,monospace;word-break:break-all;color:var(--mut)}
.ok{color:var(--acc)}.bad-t{color:var(--warn)}
.sw{display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid var(--line)}
.sw input{width:auto}.sw label{margin:0;font-weight:500}
.note{font-size:.88rem;color:var(--mut);border-left:3px solid var(--warn);padding-left:10px;margin:14px 0}
footer{padding:32px 0;border-top:1px solid var(--line);color:var(--mut);font-size:.9rem}
.cvp ul{padding-left:20px}
@media print{header.nav,section:not(#cv),.hero,footer,.noprint{display:none!important}body{background:#fff;color:#000}#cv{border:0}.card{border-color:#999;background:#fff}}
